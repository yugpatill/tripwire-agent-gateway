# gateway
DATABASE_URL=postgresql+asyncpg://tripwire:tripwire@postgres:5432/tripwire
REDIS_URL=redis://redis:6379/0
TRIPWIRE_POLICY_PATH=/app/policies/demo.yaml
TRIPWIRE_CLASSIFIER_DIR=/app/models/injection-classifier
TRIPWIRE_LLM_JUDGE_ENABLED=false
TRIPWIRE_LLM_JUDGE_MODEL=
TRIPWIRE_PII_MODE=patterns
TRIPWIRE_MODE=enforce
# development | production (production: new keys default to MCP session scope `header`).
TRIPWIRE_ENV=development
# MCP proxy: upstream servers file and how long a held call waits for an operator.
TRIPWIRE_MCP_UPSTREAMS=/app/mcp/upstreams.docker.yaml
TRIPWIRE_APPROVAL_TIMEOUT_S=120
# Console session signing key: use 32+ random bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Read-only console demo account: password "demo" outside production; in production
# only when set here (leave empty to disable it).
DEMO_READONLY_PASSWORD=
CORS_ORIGINS=http://localhost:3000
PLAYGROUND_PROVIDER=anthropic
PLAYGROUND_MODEL=
PLAYGROUND_DAILY_RUN_CAP=50
# Optional playground limits (defaults shown): see docs/playground.md
# PLAYGROUND_IP_HOURLY_LIMIT=5
# PLAYGROUND_MAX_STEPS=8
# PLAYGROUND_MAX_OUTPUT_TOKENS=4000
# PLAYGROUND_MAX_CONCURRENT=4
# PLAYGROUND_TRUST_FORWARDED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1/stream

# evals
TRIPWIRE_URL=http://localhost:8000
TRIPWIRE_API_KEY=
