  "components": {
    "schemas": {
      "ApprovalDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny"
            ],
            "title": "Decision"
          },
          "scope": {
            "type": "string",
            "enum": [
              "once",
              "session"
            ],
            "title": "Scope",
            "default": "once"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ApprovalDecision"
      },
      "ApprovalRecord": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "call",
              "tool_quarantine",
              "tool_change"
            ],
            "title": "Kind"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "denied",
              "expired"
            ],
            "title": "Status"
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "once",
                  "session"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "tool",
          "session_id",
          "event_id",
          "status",
          "scope",
          "decided_by",
          "detail",
          "expires_at",
          "decided_at",
          "created_at"
        ],
        "title": "ApprovalRecord"
      },
      "CustomAttack": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "text"
        ],
        "title": "CustomAttack"
      },
      "Decision": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "allow",
              "block",
              "redact",
              "require_approval",
              "log_only"
            ],
            "title": "Action"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "arg_labels": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/Provenance"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Arg Labels"
          },
          "detectors": {
            "items": {
              "$ref": "#/components/schemas/DetectorResult"
            },
            "type": "array",
            "title": "Detectors"
          },
          "redacted_args": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redacted Args"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "action",
          "rule_id",
          "message",
          "arg_labels",
          "detectors",
          "redacted_args",
          "latency_ms",
          "approval_id"
        ],
        "title": "Decision"
      },
      "DetectorResult": {
        "properties": {
          "detector": {
            "type": "string",
            "enum": [
              "heuristic",
              "classifier",
              "classifier_shadow",
              "llm_judge",
              "secrets",
              "pii",
              "manifest"
            ],
            "title": "Detector"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "spans": {
            "items": {
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Spans"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "detector",
          "score",
          "spans",
          "reason"
        ],
        "title": "DetectorResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "Provenance": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "trust": {
            "type": "string",
            "enum": [
              "trusted",
              "untrusted",
              "suspicious",
              "untrusted_origin"
            ],
            "title": "Trust"
          },
          "confidentiality": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "secret"
            ],
            "title": "Confidentiality"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          }
        },
        "type": "object",
        "required": [
          "source",
          "trust",
          "confidentiality",
          "event_id"
        ],
        "title": "Provenance"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse"
      },
      "ResultCheck": {
        "properties": {
          "content_redacted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Content Redacted"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/Provenance"
            },
            "type": "array",
            "title": "Labels"
          },
          "detectors": {
            "items": {
              "$ref": "#/components/schemas/DetectorResult"
            },
            "type": "array",
            "title": "Detectors"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          }
        },
        "type": "object",
        "required": [
          "content_redacted",
          "labels",
          "detectors",
          "decision"
        ],
        "title": "ResultCheck"
      },
      "RunRequest": {
        "properties": {
          "scenario_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          },
          "custom": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CustomAttack"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "RunRequest"
      },
      "SessionCreate": {
        "properties": {
          "agent_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Agent Name"
          },
          "user_prompt": {
            "type": "string",
            "maxLength": 100000,
            "title": "User Prompt"
          },
          "mode": {
            "type": "string",
            "enum": [
              "enforce",
              "shadow"
            ],
            "title": "Mode",
